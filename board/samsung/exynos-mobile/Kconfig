if TARGET_EXYNOS_MOBILE

config ENV_SOURCE_FILE
	default "exynos-mobile"

config LNX_KRNL_IMG_TEXT_OFFSET_BASE
	default TEXT_BASE

config SYS_BOARD
	default "exynos-mobile"

config SYS_CONFIG_NAME
	default "exynos-mobile"

config SYS_VENDOR
	default "samsung"

config EXYNOS_MOBILE_A51
	bool "Samsung Galaxy A51 (Exynos 9611) S-BOOT support"
	select EVENT
	help
	  Log the PMU reset reason (RST_STAT) and the S-BOOT INFORM2/INFORM3
	  registers at boot, export them as the rst_stat and reset_reason
	  environment variables, and add the "sboot" command, which resets
	  into an S-BOOT target (normal, download, upload, recovery). Also
	  sets the DECON trigger so the simple-framebuffer shows on the panel.

endif # TARGET_EXYNOS_MOBILE
