/*
 * Galaxy A51: no input device (the ramlog console is write-only, the power
 * key is dead), so boot at once. The FIT (kernel + dtb + initramfs) is the
 * ramdisk the previous bootloader loaded: uniLoader's at 0x84000000, passed
 * as linux,initrd-start in the FDT it hands over. If bootm fails, reset
 * into BOOT instead of sitting at the prompt until the watchdog fires.
 */
stdin=serial
stdout=serial,vidconsole
stderr=serial,vidconsole

bootdelay=0
a51_fallback=normal
bootcmd=bootm ${prevbl_initrd_start_addr};
	echo "a51: bootm failed, reset into ${a51_fallback} in 10 s";
	sleep 10; sboot ${a51_fallback}
